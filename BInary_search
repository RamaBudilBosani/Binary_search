arr = [2, 5, 8, 12, 16, 23, 38, 45, 56, 72, 91,98]  # takes the values 
target = 45                                         # here we declare the target

def binary_search(arr, target):
    low, high = 0, len(arr)-1         # two-pointer approach
    while low <= high:
        mid = (low + high)//2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    return -1

print(binary_search(arr, target))   # using the function
